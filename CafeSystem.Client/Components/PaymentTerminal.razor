@implements IDisposable
@inject CafeSystem.Client.Services.OrderState OrderState

<div style="padding: 2.5rem; display: flex; flex-direction: column; height: 100%; box-sizing: border-box;">
    <div style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center; max-width: 480px; margin: 0 auto; width: 100%; gap: 1.5rem;">
        
        <div style="text-align: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-secondary); font-weight: 600;">Total Amount Due</span>
            <h3 class="font-heading" style="margin: 0.3rem 0 0 0; font-size: 2.5rem; color: var(--color-expresso);">
                $@OrderState.Total.ToString("0.00")
            </h3>
        </div>

        <!-- Cash Button -->
        <button class="payment-method-btn @(OrderState.SelectedPaymentMethod == "Cash" ? "active" : "")"
                style="padding: 1rem 1.5rem; justify-content: space-between; border-width: 2px; align-items: center; width: 100%; border-radius: var(--radius-md);"
                @onclick='() => OrderState.SelectPaymentMethod("Cash")'>
            <div style="display: flex; align-items: center; gap: 0.8rem;">
                <span style="font-size: 2rem;">💵</span>
                <div style="text-align: left;">
                    <span style="font-size: 1.3rem; font-weight: 700; display: block;">Cash Payment</span>
                    <span style="font-size: 0.85rem; color: var(--text-secondary);">Enter tendered cash on numpad</span>
                </div>
            </div>

            @if (OrderState.SelectedPaymentMethod == "Cash" && OrderState.CashTendered > 0)
            {
                <div style="display: flex; flex-direction: column; align-items: flex-end; justify-content: center; text-align: right;">
                    <span style="font-size: 1.6rem; font-weight: 700; margin: 0;">$@OrderState.CashInputString</span>
                    @if (OrderState.CashTendered >= OrderState.Total && OrderState.Total > 0)
                    {
                        <span style="font-size: 0.95rem; color: #2E7D32; font-weight: 600; margin-top: 0.2rem;">
                            Change: $@OrderState.Change.ToString("0.00")
                        </span>
                    }
                    else if (OrderState.CashTendered > 0 && OrderState.CashTendered < OrderState.Total)
                    {
                        <span style="font-size: 0.95rem; color: #D32F2F; font-weight: 600; margin-top: 0.2rem;">
                            Missing: $@((OrderState.Total - OrderState.CashTendered).ToString("0.00"))
                        </span>
                    }
                </div>
            }
        </button>

        <!-- Card Button -->
        <button class="payment-method-btn @(OrderState.SelectedPaymentMethod == "Card" ? "active" : "")"
                style="padding: 1rem 1.5rem; justify-content: space-between; border-width: 2px; align-items: center; width: 100%; border-radius: var(--radius-md);"
                @onclick='() => OrderState.SelectPaymentMethod("Card")'>
            <div style="display: flex; align-items: center; gap: 0.8rem;">
                <span style="font-size: 2rem;">💳</span>
                <div style="text-align: left;">
                    <span style="font-size: 1.3rem; font-weight: 700; display: block;">Credit / Debit Card</span>
                    <span style="font-size: 0.85rem; color: var(--text-secondary);">POS Terminal tap or chip</span>
                </div>
            </div>
            <div style="text-align: right;">
                <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-chambray);">$@OrderState.Total.ToString("0.00")</span>
            </div>
        </button>

        @if (!string.IsNullOrEmpty(OrderState.SubmitError))
        {
            <div style="background: rgba(211, 47, 47, 0.1); border: 1px solid #D32F2F; color: #D32F2F; padding: 0.75rem 1rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem;">
                ⚠️ @OrderState.SubmitError
            </div>
        }
    </div>

    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 1.5rem; margin-top: auto; padding-top: 1.5rem; border-top: 1px solid rgba(107, 85, 61, 0.1);">
        <button style="background: rgba(211, 47, 47, 0.1); border: none; color: #D32F2F; font-size: 1.2rem; font-weight: 700; cursor: pointer; text-transform: uppercase; padding: 1rem 2rem; border-radius: var(--radius-md); transition: all 0.2s;"
                disabled="@OrderState.IsSubmitting"
                @onclick="OrderState.CancelCheckout">
            CANCEL
        </button>

        <button class="btn-primary"
                style="height: 65px; font-size: 1.4rem; border-radius: var(--radius-md); padding: 0 3rem; display: flex; align-items: center; gap: 0.8rem;"
                disabled="@(!OrderState.CanSubmitOrder)"
                @onclick="OrderState.SubmitOrderAsync">
            @if (OrderState.IsSubmitting)
            {
                <span>⏳ Saving to DB...</span>
            }
            else if (OrderState.SelectedPaymentMethod == "Cash")
            {
                <span>PAY $@(OrderState.CashTendered > 0 ? OrderState.CashInputString : OrderState.Total.ToString("0.00"))</span>
            }
            else
            {
                <span>PAY $@OrderState.Total.ToString("0.00")</span>
            }
        </button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        OrderState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        OrderState.OnChange -= StateHasChanged;
    }
}
