@page "/"
@using CafeSystem.Client.Components

<PageTitle>Lumina Cafe - POS</PageTitle>

<div class="pos-layout">
    <div class="pos-products-area" style="@(OrderState.IsCheckingOut ? "flex: 0 0 500px;" : "")">
        @if (OrderState.IsCheckingOut)
        {
            <NumpadPanel />
        }
        else
        {
            <ProductGrid />
        }
    </div>

    <div class="pos-receipt-area"
         style="@(OrderState.IsCheckingOut ? "flex: 1; width: auto; background: var(--bg-primary);" : "")">
        @if (OrderState.IsCheckingOut)
        {
            <PaymentTerminal />
        }
        else
        {
            <CartPanel />
        }
    </div>
</div>
